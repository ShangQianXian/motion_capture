      "description": "Default high quality offline pipeline using RTMDet-m, RTMPose-m, and MotionBERT."
    },
    "quality_plus": {
      "display_name": "High Quality Plus",
      "description": "Optional enhanced body 2D pipeline using RTMPose-x. Falls back to quality when unavailable."
    },
    "fallback_cpu": {
      "display_name": "CPU Fallback",
      "description": "Reduced quality fallback for machines without CUDA or when CUDA checks fail."
    },
    "hand_enhanced": {
      "display_name": "Enhanced Hands",
      "description": "Optional hand detection and hand pose models for more detailed finger motion."
    }
